## Door Open
alias: Garage Door Notification
description: Notify Discord when garage door opens or closes
triggers:
  - entity_id:
      - binary_sensor.third_reality_inc_3rdts01056z
    to: 'on'
    id: opened
    trigger: state
  - entity_id:
      - binary_sensor.third_reality_inc_3rdts01056z
    to: 'off'
    id: closed
    trigger: state
conditions: []
actions:
  - choose:
      - conditions:
          - condition: trigger
            id: opened
        sequence:
          - data:
              message: 🚨 Garage door **opened** at {{ now().strftime('%H:%M') }}
            action: notify.discord_garage
      - conditions:
          - condition: trigger
            id: closed
        sequence:
          - data:
              message: ✅ Garage door **closed** at {{ now().strftime('%H:%M') }}
            action: notify.discord_garage
mode: single


## Door Left Open
alias: Garage door Open 5mins
description: Notifies Discord every 5 minutes when the garage door is left open
triggers:
  - type: opened
    device_id: f69a9b56760b49db333accb8db43cc7e
    entity_id: 8d1c4d6729323917dd73e07434c9356c
    domain: binary_sensor
    trigger: device
    for:
      hours: 0
      minutes: 5
      seconds: 0
conditions: []
actions:
  - repeat:
      sequence:
        - action: notify.discord_garage
          metadata: {}
          data:
            message: Garage Door is still open!
        - delay:
            hours: 0
            minutes: 5
            seconds: 0
      until:
        - condition: state
          entity_id: binary_sensor.8d1c4d6729323917dd73e07434c9356c
          state: 'off'
mode: single




